# Copy this file to .env and fill in the values from
# https://supabase.com/dashboard/project/nttuahswduqupiykguhk/settings/api
# (Project Settings → API). Never commit the real .env file.

EXPO_PUBLIC_SUPABASE_URL=https://nttuahswduqupiykguhk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Calendar OAuth client id (Web application type) — from
# https://console.cloud.google.com/apis/credentials for this project.
# Safe to be EXPO_PUBLIC_*: a Google OAuth client id is meant to be
# public, it's embedded in the authorize URL the browser navigates to.
# The client SECRET is never in this app — it lives only as an Edge
# Function secret (`supabase/functions/google-calendar-oauth-callback`),
# set via the Supabase dashboard, not here.
EXPO_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
